# ==============================================================================
# HotSeat — Environment Variables Configuration
# ==============================================================================
# When deploying to Vercel:
# Add these variables under your Vercel Project -> Settings -> Environment Variables.
#
# When developing locally:
# Copy this file to .env.local:
#   cp .env.example .env.local
# and paste your real Supabase credentials below.
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Public API Key (from Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon public)
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
